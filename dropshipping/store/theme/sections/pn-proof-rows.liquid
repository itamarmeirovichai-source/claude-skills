{{ 'pawnook.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="{{ section.settings.heading_size }}" style="margin-bottom:1.6rem">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="pn-proof">
      {%- for block in section.blocks -%}
        <div class="pn-proof__row" {{ block.shopify_attributes }}>
          {%- if block.settings.quote != blank -%}<p class="pn-proof__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>{%- endif -%}
          <p class="pn-proof__fix">{{ block.settings.fix }}</p>
          {%- if block.settings.proof != blank -%}<p class="pn-proof__proof">{{ block.settings.proof }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "What we fixed",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "default": "What we fixed", "label": "Heading" },
    { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Medium"},{"value":"h1","label":"Large"}], "default": "h2", "label": "Heading size" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "row", "name": "Complaint → fix → proof", "limit": 6,
      "settings": [
        { "type": "text", "id": "quote", "label": "Customer complaint, in their words (from a real review)" },
        { "type": "text", "id": "fix", "label": "What this product does instead (proven on the sample)" },
        { "type": "text", "id": "proof", "label": "Where the proof is (e.g. the push test in the video)" }
      ]
    }
  ],
  "presets": [ { "name": "What we fixed", "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
