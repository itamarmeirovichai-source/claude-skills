{{ 'pawnook.css' | asset_url | stylesheet_tag }}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width" style="padding:40px 0">
    <h2 class="h2" style="margin:0 0 .6rem">{{ section.settings.heading }}</h2>
    <p class="pn-rules__lead">{{ section.settings.text }}</p>
    <div class="pn-rules">
      <div class="pn-rules__col pn-rules__col--yes"><h3 class="h4">{{ section.settings.yes_heading }}</h3><ul role="list">{%- for block in section.blocks -%}{%- if block.type == 'yes' -%}<li {{ block.shopify_attributes }}><span class="pn-rules__y">✓</span>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}</ul></div>
      <div class="pn-rules__col pn-rules__col--no"><h3 class="h4">{{ section.settings.no_heading }}</h3><ul role="list">{%- for block in section.blocks -%}{%- if block.type == 'no' -%}<li {{ block.shopify_attributes }}><span class="pn-rules__n">✕</span>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}</ul></div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Our rules (yes / no)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our rules" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We are a small new store. These are the rules we run on, written down so you can hold us to them." },
    { "type": "text", "id": "yes_heading", "label": "Yes column heading", "default": "What we do" },
    { "type": "text", "id": "no_heading", "label": "No column heading", "default": "What we refuse to do" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "yes", "name": "We do", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Ship only from US warehouses" } ] },
    { "type": "no", "name": "We refuse", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Countdown timers" } ] }
  ],
  "presets": [ { "name": "Our rules (yes / no)", "blocks": [
    { "type": "yes", "settings": { "text": "Ship only from US warehouses, 1–2 business days to dispatch" } },
    { "type": "yes", "settings": { "text": "Read hundreds of real reviews before choosing a product" } },
    { "type": "yes", "settings": { "text": "Order a sample and test every claim at home" } },
    { "type": "yes", "settings": { "text": "Include shipping in the price" } },
    { "type": "yes", "settings": { "text": "Answer every email within one business day" } },
    { "type": "no", "settings": { "text": "Countdown timers, stock counters, \"12 people are viewing\"" } },
    { "type": "no", "settings": { "text": "\"Was $99\" prices nobody ever paid" } },
    { "type": "no", "settings": { "text": "Reviews we did not earn, or AI \"customers\"" } },
    { "type": "no", "settings": { "text": "Health claims about your pet" } },
    { "type": "no", "settings": { "text": "Shipping from overseas and calling it \"fast\"" } } ] } ]
}
{% endschema %}
