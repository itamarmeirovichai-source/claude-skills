{{ 'pawnook.css' | asset_url | stylesheet_tag }}
{%- assign prod = section.settings.product -%}
<section class="pn-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width pn-hero__grid">
    <div class="pn-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="pn-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="pn-hero__title">{{ section.settings.heading }}</h1>
      <p class="pn-hero__sub">{{ section.settings.subheading }}</p>
      <div class="pn-hero__cta">
        {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}<a class="button button--secondary" href="{{ section.settings.button_link_2 | default: '/pages/about' }}">{{ section.settings.button_label_2 }}</a>{%- endif -%}
      </div>
      <ul class="pn-hero__ticks" role="list">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ block.settings.text }}</li>{%- endfor -%}
      </ul>
    </div>
    <div class="pn-hero__art">
      {%- if prod != blank and prod.featured_image != blank -%}
        {%- assign hero_alt = prod.featured_image.alt | default: prod.title -%}
        <a href="{{ prod.url }}">{{ prod.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 48vw, 100vw', widths: '600, 900, 1200', class: 'pn-hero__img', alt: hero_alt }}</a>
      {%- elsif section.settings.use_asset_image -%}
        <figure class="pn-hero__fig"><img class="pn-hero__img" src="{{ 'pn-hero.jpg' | asset_url }}" width="1200" height="900" alt="Illustration: a cat eating from a raised ceramic bowl" loading="eager"><figcaption class="pn-hero__cap">Illustration</figcaption></figure>
      {%- else -%}
        <svg class="pn-hero__svg" viewBox="0 0 600 480" role="img" aria-label="Illustration: a cat eating from a raised bowl">
          <defs><linearGradient id="pnbg{{ section.id }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#EFE8DC"/><stop offset="1" stop-color="#E2D8C6"/></linearGradient></defs>
          <rect x="0" y="0" width="600" height="480" rx="28" fill="url(#pnbg{{ section.id }})"/>
          <ellipse cx="300" cy="420" rx="240" ry="22" fill="#1F1A17" opacity=".08"/>
          <!-- raised bowl stand -->
          <rect x="250" y="330" width="100" height="70" rx="10" fill="#2F4F3A"/>
          <rect x="228" y="396" width="144" height="16" rx="8" fill="#243E2E"/>
          <ellipse cx="300" cy="330" rx="92" ry="24" fill="#3B5F48"/>
          <ellipse cx="300" cy="326" rx="78" ry="17" fill="#FBF8F3"/>
          <ellipse cx="300" cy="324" rx="60" ry="10" fill="#D9A066"/>
          <!-- cat -->
          <ellipse cx="170" cy="330" rx="86" ry="60" fill="#1F1A17"/>
          <circle cx="226" cy="282" r="44" fill="#1F1A17"/>
          <path d="M196 252 L190 212 L222 240 Z" fill="#1F1A17"/><path d="M256 252 L262 212 L230 240 Z" fill="#1F1A17"/>
          <path d="M199 254 L196 228 L214 244 Z" fill="#D9A066"/><path d="M253 254 L256 228 L238 244 Z" fill="#D9A066"/>
          <circle cx="214" cy="284" r="5" fill="#FBF8F3"/><circle cx="240" cy="284" r="5" fill="#FBF8F3"/>
          <circle cx="215" cy="285" r="2.4" fill="#1F1A17"/><circle cx="241" cy="285" r="2.4" fill="#1F1A17"/>
          <path d="M100 330 C 60 300, 50 380, 96 370" stroke="#1F1A17" stroke-width="18" fill="none" stroke-linecap="round"/>
          <path d="M228 300 l-18 6 M228 304 l-18 12 M228 296 l-18 0" stroke="#FBF8F3" stroke-width="1.6" opacity=".8"/>
          <path d="M228 300 l18 6 M228 304 l18 12 M228 296 l18 0" stroke="#FBF8F3" stroke-width="1.6" opacity=".8"/>
          <circle cx="470" cy="120" r="54" fill="#FBF8F3" opacity=".9"/>
          <path d="M440 120 l20 20 l40 -44" stroke="#2F4F3A" stroke-width="9" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="470" y="206" text-anchor="middle" font-family="Work Sans, Arial, sans-serif" font-size="16" fill="#1F1A17">tested on a sample</text>
        </svg>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero (Pawnook)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For cats and small dogs · ships from a US warehouse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The raised bowl that stays put." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Chosen from hundreds of real one-star reviews of the bowls that wobble, rust and spill. Then tested on a sample before it went on sale." },
    { "type": "product", "id": "product", "label": "Product photo for the right side (illustration if none)" },
    { "type": "checkbox", "id": "use_asset_image", "label": "Use the uploaded illustration (assets/pn-hero.jpg)", "default": false },
    { "type": "text", "id": "button_label", "label": "Button", "default": "See the bowl" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button", "default": "How we choose products" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" }
  ],
  "blocks": [ { "type": "tick", "name": "Tick line", "limit": 4, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Shipping included" } ] } ],
  "presets": [ { "name": "Hero (Pawnook)", "blocks": [
    { "type": "tick", "settings": { "text": "Shipping included in the price" } },
    { "type": "tick", "settings": { "text": "Ships from a US warehouse" } },
    { "type": "tick", "settings": { "text": "30-day returns" } } ] } ]
}
{% endschema %}
