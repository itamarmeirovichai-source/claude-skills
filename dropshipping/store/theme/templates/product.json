{
  "sections": {
    "delivery_bar": {
      "type": "pn-delivery-bar",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "text": "Shipping included in the price"
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "text": "Ships from a US warehouse in [1\u20132] business days"
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "text": "Delivered in [3\u20137] business days"
          }
        },
        "b4": {
          "type": "item",
          "settings": {
            "text": "30-day returns, refunds within 7 working days"
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ],
      "settings": {
        "color_scheme": "scheme-2"
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "text_fit": {
          "type": "text",
          "settings": {
            "text": "For cats and dogs up to about 50 lb (23 kg)",
            "text_style": "subtitle"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "trust": {
          "type": "text",
          "settings": {
            "text": "Pay by card or PayPal. Guest checkout. No fees added at checkout.",
            "text_style": "body"
          }
        },
        "description": {
          "type": "description"
        },
        "ship": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping and returns",
            "icon": "truck",
            "content": "<p>Shipping is included in the price. Orders leave a US warehouse within [1\u20132] business days and arrive in [3\u20137] business days. Tracking by email. 30-day returns on unused items; refunds to the original payment method within 7 working days. Damaged or wrong item: send a photo within 7 days and we replace or refund, no return needed.</p>",
            "page": ""
          }
        },
        "care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "icon": "leaf",
            "content": "<p>Lift the bowl off the stand with one hand; the bowl is dishwasher-safe. Stand: wipe with a damp cloth.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "text_fit",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "description",
        "ship",
        "care"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 12
      }
    },
    "proof": {
      "type": "pn-proof-rows",
      "blocks": {
        "r1": {
          "type": "row",
          "settings": {
            "quote": "chips and cracks ridiculously easily",
            "fix": "Double-boxed. Chipped on arrival: send a photo, we replace it, no return.",
            "proof": "Shipping & Returns page; unboxing in the video above."
          }
        },
        "r2": {
          "type": "row",
          "settings": {
            "quote": "the dry food falls out while my cat is eating",
            "fix": "[Rim shape] keeps kibble in. [Proven on the sample.]",
            "proof": "30-second eating clip in the video above."
          }
        },
        "r3": {
          "type": "row",
          "settings": {
            "quote": "wobbly and rattles",
            "fix": "[X] g of ceramic on a wide base. It does not tip when nudged.",
            "proof": "Scale and push test in the video above."
          }
        }
      },
      "block_order": [
        "r1",
        "r2",
        "r3"
      ],
      "settings": {
        "heading": "What we fixed",
        "heading_size": "h2",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 24
      }
    },
    "specs": {
      "type": "pn-specs",
      "blocks": {
        "s1": {
          "type": "spec",
          "settings": {
            "label": "Height",
            "value": "[X cm]"
          }
        },
        "s2": {
          "type": "spec",
          "settings": {
            "label": "Bowl capacity",
            "value": "[X cups / X ml] each"
          }
        },
        "s3": {
          "type": "spec",
          "settings": {
            "label": "Materials",
            "value": "[stand material]; [bowl material]"
          }
        },
        "s4": {
          "type": "spec",
          "settings": {
            "label": "Ships from",
            "value": "US warehouse"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3",
        "s4"
      ],
      "settings": {
        "heading": "Size and specs",
        "padding_top": 12,
        "padding_bottom": 24
      }
    },
    "note": {
      "type": "pn-note",
      "settings": {
        "title": "A note for large and giant breeds",
        "text": "Raised bowls are not recommended for large and giant breeds by some veterinary studies. If your dog is a large or giant breed, please ask your vet before using any raised bowl.",
        "padding_top": 0,
        "padding_bottom": 24
      }
    },
    "steps": {
      "type": "pn-steps",
      "blocks": {
        "t1": {
          "type": "step",
          "settings": {
            "title": "Order",
            "text": "Guest checkout, card or PayPal. The price includes shipping."
          }
        },
        "t2": {
          "type": "step",
          "settings": {
            "title": "We ship from the US",
            "text": "Your order leaves a US warehouse within [1\u20132] business days. Tracking by email."
          }
        },
        "t3": {
          "type": "step",
          "settings": {
            "title": "Delivered, or your money back",
            "text": "30-day returns. Refunds within 7 working days."
          }
        }
      },
      "block_order": [
        "t1",
        "t2",
        "t3"
      ],
      "settings": {
        "heading": "How ordering works",
        "color_scheme": "scheme-2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "honest": {
      "type": "pn-honest-line",
      "settings": {
        "text": "This is a new store. Reviews here come only from verified buyers, requested after delivery with no conditions. We never pay for reviews."
      }
    },
    "sticky": {
      "type": "pn-sticky-atc",
      "settings": {
        "label": "Add to cart"
      }
    },
    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where does my order ship from?",
            "icon": "truck",
            "row_content": "<p>From a warehouse in the United States. It leaves within 1\u20132 business days and the delivery window shown on the product page is the supplier's own figure.</p>",
            "page": ""
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is shipping really included?",
            "icon": "price_tag",
            "row_content": "<p>Yes. The price on the product page is what you pay. Nothing is added at checkout.</p>",
            "page": ""
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if it arrives damaged?",
            "icon": "box",
            "row_content": "<p>Send a photo within 7 days of delivery. We replace it or refund, and you do not need to send it back.</p>",
            "page": ""
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why are there so few reviews?",
            "icon": "chat_bubble",
            "row_content": "<p>Because we are new, and we only show reviews from verified buyers, asked after delivery with no reward attached. We would rather show three real ones than three hundred fake ones.</p>",
            "page": ""
          }
        },
        "q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is a raised bowl right for my pet?",
            "icon": "question_mark",
            "row_content": "<p>Our bowls are made for cats and dogs up to about 50 lb. Some veterinary studies do not recommend raised bowls for large and giant breeds; if your dog is one, ask your vet first. We make no health claims either way.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
      "settings": {
        "caption": "",
        "heading": "Questions people ask us",
        "heading_size": "h2",
        "heading_alignment": "left",
        "layout": "none",
        "color_scheme": "scheme-1",
        "container_color_scheme": "scheme-2",
        "open_first_collapsible_row": true,
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "delivery_bar",
    "main",
    "proof",
    "specs",
    "note",
    "faq",
    "steps",
    "honest",
    "sticky"
  ]
}