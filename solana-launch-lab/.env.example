# Solana Launch Lab — example configuration.
# Copy to `.env` if you want to change a default. Every value is optional.
# There is NO place here for a wallet, private key, seed phrase or exchange credential:
# the application is read-only and has no use for one.

# demo = synthetic data only, no network calls. live = read-only public-data connectors enabled.
LAUNCHLAB_MODE=demo

# Local server (bound to loopback only).
LAUNCHLAB_HOST=127.0.0.1
LAUNCHLAB_PORT=8765

# Where the SQLite database lives.
LAUNCHLAB_DB=data/launchlab.sqlite3

# Read-only Solana JSON-RPC endpoint. The public endpoint is rate-limited and refuses some holder queries.
# If your own endpoint's URL embeds an access token, keep it only in your local `.env` (git-ignored).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Store raw provider responses locally? Check each provider's terms before turning one on.
STORE_RAW_SOLANA_RPC=1
STORE_RAW_DEXSCREENER=0
STORE_RAW_GECKOTERMINAL=0

# Paper-trading defaults (see PROJECT_SPEC.md section 9).
PAPER_SIZE_SOL=0.5
PAPER_LATENCY_S=8
PAPER_DECISION_DELAY_S=90
PAPER_FAIL_PROB=0.15
PAPER_PRIORITY_FEE_SOL=0.0005
PAPER_EXTRA_SLIPPAGE_BPS=100
PAPER_SEED=20261123
