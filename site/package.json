{
  "name": "vxo-studio-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc -p functions/tsconfig.json",
    "build": "astro check && tsc -p functions/tsconfig.json && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview --port 4321",
    "media:placeholders": "bash scripts/placeholder-media.sh",
    "media:check": "node scripts/check-media.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.7",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
