---
// Objection chip: one line where the doubt arises; tap to expand 2–3 sentences (ref 39 §3.5).
interface Props { q: string; a: string; tone?: 'dark' | 'light' }
const { q, a, tone = 'dark' } = Astro.props;
---
<details class:list={['chip', tone]}>
  <summary><span class="dot" aria-hidden="true"></span>{q}</summary>
  <p>{a}<slot /></p>
</details>
<style>
  .chip { width: fit-content; max-width: 100%; font-size: 0.86rem; }
  .chip summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-dim); transition: border-color 0.18s var(--ease), color 0.18s var(--ease); }
  .chip summary::-webkit-details-marker { display: none; }
  .chip summary:hover, .chip[open] summary { border-color: var(--brass); color: var(--text); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brass); }
  .chip p { margin: 10px 0 0; padding: 12px 14px; max-width: 46ch; border-left: 1px solid var(--brass); color: var(--text-dim); font-size: 0.9rem; }
</style>
