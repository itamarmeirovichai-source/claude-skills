---
// Global story chrome on the home page: chapter mark + progress (desktop), the sound pill
// ("Sound on · meet the crew"), the sticky "5 free frames →" CTA, the caption live region and the film player.
import { media, lineText } from '../../lib/media';
import { site } from '../../lib/site';
---
<div class="chapter" data-chapter-mark aria-hidden="true">
  <span class="chapter-text" data-chapter-text>Scene 1 · The take</span>
  <span class="rail"><i data-progress></i></span>
</div>

<div class="story-bar" data-story-bar>
  <div class="bar-left">
    <button type="button" class="pill sound" data-crew-sound aria-pressed="false">
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="sound-label" data-sound-label><span class="long">Sound on · meet the crew</span><span class="short">Sound on</span></span>
    </button>
    <button type="button" class="pill ghost" data-hide-hosts>Hide crew</button>
  </div>
  <a class="pill cta" href={site.stickyCta.href} data-sticky-cta>{site.stickyCta.label} <span aria-hidden="true">→</span></a>
  <div class="pill-vee" data-pill-vee aria-hidden="true">
    <alpha-video class="pv-av" premultiplied={media.vee.premultiplied ? '' : undefined}></alpha-video>
    <p class="pv-bubble" data-pill-bubble>{lineText('act_v1')}</p>
  </div>
</div>

<p class="sr-only" data-crew-live aria-live="polite"></p>

<dialog class="film-dialog" data-film-dialog aria-label="Spec film" data-lenis-prevent>
  <div class="fd-inner">
    <video data-fd-video playsinline controls preload="none"></video>
    <span class="spec-label" data-fd-label></span>
    <form method="dialog"><button class="fd-x" aria-label="Close film">✕</button></form>
    <div class="fd-actions btn-row">
      <a class="btn btn-primary" href="#start" data-fd-cta>Get my 5 free frames</a>
      <a class="btn" href="/work" data-fd-more>About this film</a>
    </div>
  </div>
</dialog>

<style>
  .chapter { display: none; }
  @media (min-width: 1100px) {
    .chapter {
      display: flex; position: fixed; z-index: 20; left: 18px; top: 50%; translate: 0 -50%; flex-direction: column; align-items: center; gap: 14px;
      opacity: 0; transition: opacity 0.6s var(--ease-lux);
    }
    :global(html.story-on) .chapter { opacity: 1; }
    .chapter-text { writing-mode: vertical-rl; rotate: 180deg; font: 600 0.66rem/1 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-faint); white-space: nowrap; }
    .rail { width: 1px; height: 120px; background: var(--line); position: relative; overflow: hidden; }
    .rail i { position: absolute; inset: 0; background: var(--brass); transform-origin: top; transform: scaleY(0); }
  }

  .story-bar {
    position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; height: calc(56px + env(safe-area-inset-bottom)); padding: 0 12px env(safe-area-inset-bottom);
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    background: rgb(15 14 13 / 0.86); border-top: 1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .bar-left { display: flex; gap: 6px; align-items: center; min-width: 0; }
  .pill {
    min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line-strong); background: rgb(15 14 13 / 0.7);
    color: var(--text-dim); font: 500 0.82rem/1 var(--sans); display: inline-flex; align-items: center; gap: 8px; cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease), background-color 0.18s var(--ease), opacity 0.35s var(--ease-lux), translate 0.45s var(--ease-lux);
  }
  .pill:hover { color: var(--text); border-color: var(--brass); }
  .pill.ghost { border-color: transparent; padding-inline: 8px; color: var(--text-faint); }
  .sound[aria-pressed='true'] { border-color: var(--brass); color: var(--text); }
  .sound :global(.long) { display: none; }
  @media (min-width: 560px) { .sound :global(.long) { display: inline; } .sound :global(.short) { display: none; } }
  .eq { display: inline-flex; gap: 2px; align-items: flex-end; height: 12px; }
  .eq i { width: 2px; height: 4px; background: currentColor; border-radius: 1px; }
  .sound[aria-pressed='true'] .eq i { animation: eq 0.9s var(--ease) infinite alternate; background: var(--brass-hi); }
  .sound[aria-pressed='true'] .eq i:nth-child(2) { animation-delay: 0.2s; }
  .sound[aria-pressed='true'] .eq i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes eq { to { height: 12px; } }
  .cta { background: var(--brass); border-color: var(--brass); color: #1a1510; font-weight: 600; }
  .cta:hover { background: var(--brass-hi); color: #1a1510; }
  .cta:not(.on) { opacity: 0; translate: 0 8px; pointer-events: none; visibility: hidden; transition: opacity 0.25s var(--ease-exit), translate 0.25s var(--ease-exit), visibility 0s 0.25s; }
  .cta.on { visibility: visible; }
  :global(html.hosts-hidden) .ghost { display: none; }
  @media (max-width: 559px) { .pill.ghost { display: none; } }

  @media (min-width: 900px) {
    .story-bar { left: 20px; right: auto; bottom: 20px; height: auto; padding: 0; background: none; border: 0; backdrop-filter: none; -webkit-backdrop-filter: none; gap: 10px; }
    .story-bar .pill { backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
    .cta { order: 0; }
  }
  @media (min-width: 1100px) { .story-bar { left: 64px; } }

  /* Vee pops in beside the pill when sound is switched on. */
  .pill-vee { position: absolute; left: 6px; bottom: calc(100% + 4px); width: 96px; aspect-ratio: 9 / 16; pointer-events: none; opacity: 0; translate: -24px 0; transition: opacity 0.4s var(--ease-lux), translate 0.6s var(--ease-lux); }
  .pill-vee.on { opacity: 1; translate: 0 0; }
  .pv-av { position: absolute; inset: 0; display: block; }
  .pv-av :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pv-bubble { position: absolute; left: 80%; bottom: 62%; margin: 0; width: max-content; max-width: 220px; padding: 7px 12px; border-radius: 12px 12px 12px 2px; background: var(--vermilion); color: var(--ivory); font: 400 0.98rem/1.25 var(--serif); }
  @media (min-width: 900px) { .pill-vee { width: 130px; } }
  :global(html.hosts-hidden) .pill-vee { display: none; }

  .film-dialog { padding: 0; border: 0; background: transparent; max-width: none; max-height: none; width: 100%; height: 100%; color: var(--text); }
  .film-dialog::backdrop { background: rgb(8 7 6 / 0.82); backdrop-filter: blur(4px); }
  .fd-inner { position: relative; height: 100%; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 20px; }
  .fd-inner video { height: min(78svh, 760px); aspect-ratio: 9 / 16; max-width: calc(100vw - 32px); object-fit: cover; border-radius: 16px; background: #000; box-shadow: 0 40px 90px rgb(0 0 0 / 0.6); }
  .fd-inner .spec-label { position: absolute; top: 30px; left: 50%; translate: -50% 0; }
  .fd-x { position: fixed; right: 16px; top: 16px; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line-strong); background: rgb(15 14 13 / 0.7); cursor: pointer; }
</style>
