---
// Sticks to the bottom of the viewport while its act is on screen, then settles on the act's floor.
// Characters stand on it, so they wait at the edge, arrive, and leave with their scene.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={['dock', cls]} data-dock><div class="wrap dock-inner"><slot /></div></div>
<style>
  .dock { position: sticky; bottom: var(--dock-h); height: 0; z-index: 4; pointer-events: none; }
  .dock-inner { position: relative; height: 0; }
</style>
