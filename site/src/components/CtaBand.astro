---
interface Props { title?: string; sub?: string }
const { title = 'Your product deserves a film. Start with five frames.', sub = 'Free, no call, ready in 3–5 business days.' } = Astro.props;
---
<section class="section band">
  <div class="wrap">
    <h2>{title}</h2>
    <p class="lede">{sub}</p>
    <div class="btn-row"><a class="btn btn-primary" href="/frames">Get my 5 free frames</a><a class="btn" href="/work">See all films</a></div>
  </div>
</section>
<style>
  .band { background: radial-gradient(70% 120% at 20% 0%, rgb(110 31 36 / 0.35), transparent 60%), var(--ink-1); }
</style>
