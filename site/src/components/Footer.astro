---
import { site, t } from '../lib/site';
interface Props { home: boolean }
const { home } = Astro.props;
const address = t('{{ADDRESS}}');
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <p class="brand"><span class="mark">{site.studio}</span> · AI product films{address && <> · <span>{address}</span></>}</p>
      {home && <span class="btn-row"><button type="button" class="btn btn-ghost" data-hide-hosts>Hide the crew</button><button type="button" class="btn btn-ghost back" data-back-to-show>↑ Back to the show</button></span>}
    </div>
    <p class="disclose">Everything here is made with AI, including {site.mascot} and {site.producer}. Spec films are for invented brands, and they're labelled.</p>
    <nav aria-label="Footer">
      <a href="/work">Work</a><a href="/pricing">Pricing</a><a href="/frames">Free frames</a><a href="/ai">How we use AI</a><a href="/about">About</a><a href="/terms">Terms</a><a href="/privacy">Privacy</a>
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
    </nav>
    <p class="fine">© {new Date().getFullYear()} {site.studio} ({site.studioLong}).</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 48px 40px; background: var(--ink-0); position: relative; z-index: 2; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
  .brand { margin: 0; color: var(--text-dim); }
  .mark { font: 400 1.5rem/1 var(--serif); color: var(--ivory); letter-spacing: 0.06em; }
  .disclose { color: var(--text-dim); max-width: 60ch; margin-top: 16px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; }
  nav a { color: var(--text-dim); text-decoration: none; font-size: 0.9rem; min-height: 32px; display: inline-flex; align-items: center; }
  nav a:hover { color: var(--text); }
  .fine { color: var(--text-faint); font-size: 0.8rem; margin-top: 24px; }
</style>
