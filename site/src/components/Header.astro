---
import { site } from '../lib/site';
interface Props { home: boolean }
const { home } = Astro.props;
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/ai', label: 'How we use AI' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class:list={['site-header', { home }]}>
  <div class="wrap bar">
    <a class="logo" href="/" aria-label={`${site.studio} home`}>
      <span class="mark">{site.studio}</span>
      <span class="long">{site.studioLong}</span>
    </a>
    {home && <span class="h-chapter" data-chapter-text aria-hidden="true">Scene 1 · The take</span>}
    <nav aria-label="Main" class="nav">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary cta" href="/frames">Get 5 free frames</a>
    <details class="menu">
      <summary aria-label="Menu"><span></span><span></span></summary>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/frames">Get 5 free frames →</a></li>
      </ul>
    </details>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: rgb(15 14 13 / 0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 16px; height: var(--header-h); }
  .h-chapter { font: 600 0.62rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  @media (min-width: 1100px) { .h-chapter { display: none; } }
  .logo { display: flex; align-items: baseline; gap: 10px; text-decoration: none; margin-right: auto; flex: 0 0 auto; }
  .mark { font: 400 1.7rem/1 var(--serif); letter-spacing: 0.06em; color: var(--ivory); }
  .long { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint); display: none; }
  .nav ul { display: none; list-style: none; gap: 22px; margin: 0; padding: 0; }
  .nav a { text-decoration: none; font-size: 0.9rem; color: var(--text-dim); }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--text); }
  .cta { display: none; min-height: 40px; padding: 0.55em 1.1em; font-size: 0.85rem; }
  .menu { position: relative; }
  .menu summary { list-style: none; width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; cursor: pointer; border-radius: 10px; border: 1px solid var(--line); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 18px; height: 1.5px; background: var(--text); }
  .menu ul { position: absolute; right: 0; top: 52px; list-style: none; margin: 0; padding: 8px; min-width: 210px; background: var(--ink-2); border: 1px solid var(--line-strong); border-radius: 12px; box-shadow: 0 20px 40px rgb(0 0 0 / 0.4); }
  .menu li a { display: block; padding: 12px 14px; text-decoration: none; border-radius: 8px; }
  .menu li a:hover { background: var(--ink-3); }
  @media (min-width: 560px) { .long { display: inline; } }
  @media (max-width: 559px) { .home .logo { margin-right: 0; } .home .h-chapter { margin-right: auto; } }
  @media (min-width: 900px) {
    .nav ul { display: flex; }
    .cta { display: inline-flex; }
    .menu { display: none; }
  }
</style>
