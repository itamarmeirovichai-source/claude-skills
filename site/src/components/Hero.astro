---
// Act I · The take. H1, offer and CTA are on screen at 0 s; the films orbit Otto in a flat circle.
import { media, mediaUrl, ringFilms, SPEC_LABEL, lineText } from '../lib/media';
import { site, bfcm, bfcmOpen } from '../lib/site';
import Chip from './Chip.astro';
const films = ringFilms();
const n = films.length;
const { $comment: _c, ...headlines } = site.headlines;
const offerLive = bfcmOpen();
---
<section class="hero act" id="hero" data-state="boot" data-count={n} data-act="1" data-chapter="The take" aria-labelledby="hero-h1">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Scene 1 · The take</p>
      <h1 id="hero-h1" data-headline>{headlines.default}</h1>
      <script is:inline define:vars={{ headlines }}>
        // Message match: the H1 mirrors the ad or email that was clicked (utm_content). Swapped before paint.
        try {
          var v = new URLSearchParams(location.search).get('utm_content');
          var h = v && Object.prototype.hasOwnProperty.call(headlines, v) ? headlines[v] : null;
          if (h) { var el = document.getElementById('hero-h1'); el.textContent = h; el.dataset.variant = v; }
        } catch (e) {}
      </script>
      <p class="hero-sub">Thirty-second product films for brands people have to smell, taste or touch. Made with AI, directed by a human. Start with 5 free frames.</p>
      <div class="btn-row hero-ctas" data-inflow-cta>
        <a class="btn btn-primary" href="#start" data-frames-cta>Get my 5 free frames <span aria-hidden="true">→</span></a>
        <a class="btn" href="/work" data-pick-film>Watch a film <span aria-hidden="true">▸</span></a>
      </div>
      <Chip q="Is it really free?" a="Free means free. No card, no call. You keep the frames." />
      <p class="micro" data-ai-line tabindex="0">Made with AI, including {site.mascot}. Spec films are for invented brands.</p>
      {offerLive && <p class="offer-line"><a href="#bfcm"><b>{bfcm.name}</b> · final files by {bfcm.finalByLabel} · booking closes {bfcm.bookByLabel}</a></p>}
    </div>

    <div class="scene" data-scene>
      <div class="otto-frame" data-otto-frame>
        <alpha-video id="otto" class="otto" premultiplied={media.otto.premultiplied ? '' : undefined} data-w={media.otto.width} data-h={media.otto.height}>
          <img class="poster" src={mediaUrl(media.otto.poster)} alt={`${site.mascot}, our AI director: a tall man with an enormous waxed moustache, black turtleneck and charcoal blazer`} width={media.otto.width} height={media.otto.height} fetchpriority="high" decoding="async" onerror="this.style.visibility='hidden'" />
        </alpha-video>
        <p class="caption" data-caption aria-hidden="true">{lineText('act_o1')}</p>
        <p class="ai-tag" aria-hidden="true">AI · {site.mascot}</p>
      </div>

      <div class="ring" data-ring role="region" aria-roledescription="carousel" aria-label="Spec films circling Otto. Pick one to play it.">
        <ul class="ring-track" data-track>
          {films.map((f, i) => (
            <li class="ring-item" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${n}: ${f.brand}, ${f.duration} s`} data-i={i}>
              <a class:list={['card', { featured: f.featured }]} href={`/work/${f.slug}`} data-card={i} data-slug={f.slug}>
                <img src={mediaUrl(f.poster)} alt="" width="360" height="640" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" onerror="this.style.visibility='hidden'" />
                <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-loop-av1={mediaUrl(f.loop.av1)} data-loop-h264={mediaUrl(f.loop.h264)}></video>
                <span class="card-meta"><b>{f.cardTitle ?? f.brand}</b><span>{f.cardSub ?? f.category}</span></span>
                <span class="sr-only">{SPEC_LABEL(f)}. Play {f.title}.</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="stage" data-stage hidden role="region" aria-label="Film player">
        <div class="stage-film" data-stage-film data-lenis-prevent>
          <video data-film playsinline preload="none" aria-label="Spec film"></video>
          <span class="spec-label" data-film-label></span>
          <button type="button" class="stage-x" data-close aria-label="Close film">✕</button>
          <button type="button" class="tap-sound" data-tap-sound hidden>Tap for sound</button>
        </div>
        <div class="stage-actions btn-row">
          <button type="button" class="btn" data-pick-another>Pick another</button>
          <button type="button" class="btn btn-primary" data-continue>Continue <span aria-hidden="true">↓</span></button>
        </div>
      </div>
      <p class="ring-hint" aria-hidden="true">Pick a film · hover to hold</p>
    </div>
  </div>

  <div class="hero-controls wrap" aria-label="Show controls">
    <a class="ctl skip" href="#content" data-skip>Skip the show <span aria-hidden="true">↓</span></a>
    <button type="button" class="ctl" data-motion aria-pressed="false">Pause motion</button>
  </div>
</section>

<style>
  .hero { position: relative; z-index: 0; isolation: isolate; padding-top: clamp(20px, 4vh, 48px); overflow: clip; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(48% 52% at 70% 50%, rgb(176 141 87 / 0.16), transparent 70%),
      radial-gradient(90% 60% at 50% 120%, rgb(110 31 36 / 0.22), transparent 70%),
      linear-gradient(#141210, #0f0e0d);
  }
  .hero-grid { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); }
  .hero-copy { position: relative; z-index: 6; }
  .hero-copy h1 { margin-bottom: 0.32em; font-size: clamp(2.6rem, 7vw, 6.1rem); line-height: 1.02; max-width: 12ch; }
  .hero-sub { color: var(--text-dim); max-width: 44ch; font-size: clamp(1rem, 1.3vw, 1.12rem); margin-bottom: 26px; }
  .hero-ctas { margin-bottom: 14px; }
  .micro { margin: 18px 0 0; font-size: 0.78rem; color: var(--text-faint); width: fit-content; cursor: help; }
  .offer-line { margin: 10px 0 0; font-size: 0.82rem; }
  .offer-line a { color: var(--text-dim); text-decoration: none; border-bottom: 1px solid rgb(176 141 87 / 0.5); padding-bottom: 2px; }
  .offer-line a:hover { color: var(--text); }
  .offer-line b { color: var(--brass-hi); font-weight: 600; }

  /* Scene: Otto in the middle, the films on a flat circle around him. */
  .scene { position: relative; width: 100%; height: min(112vw, 470px); margin-inline: auto; }
  .otto-frame { position: absolute; left: 50%; top: 50%; height: 54%; aspect-ratio: 9 / 16; translate: -50% -52%; z-index: 2; }
  .otto { position: absolute; inset: 0; display: block; }
  .otto :global(canvas), .otto .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .otto :global(canvas) { opacity: 0; transition: opacity 0.6s var(--ease); }
  .otto[data-ready] :global(canvas) { opacity: 1; }
  .otto[data-ready] .poster { opacity: 0; transition: opacity 0.6s var(--ease); }
  .ai-tag { position: absolute; left: 50%; bottom: -18px; translate: -50% 0; margin: 0; font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-faint); white-space: nowrap; }
  .caption {
    position: absolute; left: 50%; bottom: 100%; translate: -50% -6px; margin: 0; z-index: 4; width: max-content; max-width: min(64vw, 260px); text-align: center;
    background: var(--ivory); color: #1a1510; font: 400 1.02rem/1.25 var(--serif); padding: 8px 14px; border-radius: 12px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35); opacity: 0; transform: translateY(6px); transition: opacity 0.35s var(--ease), transform 0.5s var(--ease);
  }
  .caption.on { opacity: 1; transform: none; }

  .ring { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .ring-track { list-style: none; margin: 0; padding: 0; position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
  .ring-item { position: absolute; left: 0; top: 0; pointer-events: auto; will-change: transform; }
  .card {
    position: relative; display: block; width: clamp(64px, 17vw, 82px); aspect-ratio: 9 / 16; border-radius: 10px; overflow: hidden; translate: -50% -50%;
    background: var(--ink-3); border: 1px solid var(--line-strong); box-shadow: 0 16px 34px rgb(0 0 0 / 0.5); text-decoration: none;
    transition: border-color 0.2s, scale 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .card img, .card video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card video { opacity: 0; transition: opacity 0.5s; }
  .card video.on { opacity: 1; }
  .card-meta { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 7px 6px; background: linear-gradient(transparent, rgb(0 0 0 / 0.75)); display: grid; font-size: 0.58rem; color: var(--text-dim); line-height: 1.2; }
  .card-meta b { font: 400 0.92rem/1.05 var(--serif); color: var(--ivory); letter-spacing: 0.04em; }
  .featured .card-meta b { font-size: 0.8rem; }
  .card.featured { border-color: rgb(176 141 87 / 0.7); }
  .card:hover, .card:focus-visible { border-color: var(--brass); scale: 1.06; box-shadow: 0 22px 44px rgb(0 0 0 / 0.55); }
  .ring-hint { position: absolute; left: 0; right: 0; bottom: -4px; margin: 0; text-align: center; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); }

  .hero-controls { position: relative; z-index: 8; display: flex; justify-content: flex-end; align-items: center; gap: 8px; padding-block: 18px 24px; }
  .ctl {
    min-height: 44px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: rgb(15 14 13 / 0.6);
    color: var(--text-dim); font-size: 0.8rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
  }
  .ctl:hover { color: var(--text); border-color: var(--brass); }
  .ctl[aria-pressed='true'] { border-color: var(--brass); color: var(--text); }

  @media (min-width: 900px) {
    .hero { position: sticky; top: 64px; min-height: calc(100vh - 64px); min-height: calc(100svh - 64px); display: grid; grid-template-rows: 1fr auto; padding-top: 0; }
    .hero-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; gap: 24px; }
    .scene { height: min(calc(100svh - 190px), 760px); }
    .card { width: clamp(92px, 7.6vw, 124px); }
    .caption { font-size: 1.15rem; }
  }

  /* Without JS, and under reduced motion before layout: cards sit in a quiet row below Otto. */
  :global(html:not(.js)) .ring-track { position: static; width: auto; height: auto; display: flex; gap: 10px; justify-content: center; position: absolute; left: 0; right: 0; top: auto; bottom: 0; }
  :global(html:not(.js)) .ring-item { position: static; }
  :global(html:not(.js)) .card { translate: none; }

  /* Stage: the enlarged film. */
  .stage { position: absolute; z-index: 7; inset: 0; display: grid; justify-items: center; align-content: center; gap: 12px; pointer-events: none; }
  .stage[hidden] { display: none; }
  .stage-film { position: relative; height: min(88%, 680px); max-height: calc(100% - 64px); aspect-ratio: 9 / 16; border-radius: 16px; overflow: hidden; background: #000; box-shadow: 0 40px 90px rgb(0 0 0 / 0.65); pointer-events: auto; transform-origin: 50% 50%; }
  .stage-film video { width: 100%; height: 100%; object-fit: cover; }
  .stage-film .spec-label { position: absolute; left: 10px; top: 10px; right: 60px; width: fit-content; }
  .stage-x { position: absolute; right: 8px; top: 8px; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: rgb(15 14 13 / 0.6); cursor: pointer; }
  .tap-sound { position: absolute; left: 50%; bottom: 16px; translate: -50% 0; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 0; background: var(--ivory); color: #1a1510; font-weight: 600; cursor: pointer; }
  .stage-actions { pointer-events: auto; justify-content: center; }
  .stage.docked .stage-film { height: min(62%, 420px); }
  .pulse { animation: pulse 1.1s var(--ease) 1; }
  @keyframes pulse { 40% { box-shadow: 0 0 0 6px rgb(176 141 87 / 0.25); } }
  .hero[data-state='playing'] .ring, .hero[data-state='enlarging'] .ring, .hero[data-state='asking'] .ring { opacity: 0.12; transition: opacity 0.6s var(--ease); }
  .hero[data-state='playing'] .otto-frame, .hero[data-state='enlarging'] .otto-frame { opacity: 0.35; transition: opacity 0.6s var(--ease); }
  .ring { transition: opacity 0.6s var(--ease); }
  .otto-frame { transition: opacity 0.6s var(--ease), translate 0.9s var(--ease-lux); }
  /* Asking: the film docks right, Otto steps out from behind it to talk. */
  .hero[data-state='asking'] .otto-frame { translate: -100% -52%; opacity: 1; }
  .hero[data-state='asking'] .stage { justify-items: end; }
  .hero[data-state='asking'] .caption { left: 0; translate: 0 -6px; max-width: min(44vw, 240px); text-align: left; }
  :global(html.motion-paused) .card video { display: none; }
</style>
