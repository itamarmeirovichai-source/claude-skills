    },
    "otto_pop_4": {
      "text": "Quiet on set. Your turn.",
      "audio": "voice/otto_pop_4.m4a",
      "vtt": "voice/otto_pop_4.vtt"
    },
    "otto_pop_5": {
      "text": "I'm right here.",
      "audio": "voice/otto_pop_5.m4a",
      "vtt": "voice/otto_pop_5.vtt"
    },
    "otto_pop_6": {
      "text": "Psst. Down here.",
      "audio": "voice/otto_pop_6.m4a",
      "vtt": "voice/otto_pop_6.vtt"
    },
    "otto_pop_7": {
      "text": "Don't scroll past me.",
      "audio": "voice/otto_pop_7.m4a",
      "vtt": "voice/otto_pop_7.vtt"
    },
    "otto_pop_8": {
      "text": "Still here. Still brilliant.",
      "audio": "voice/otto_pop_8.m4a",
      "vtt": "voice/otto_pop_8.vtt"
    },
    "otto_success_1": {
      "text": "Got it. Itamar's on it.",
      "audio": "voice/otto_success_1.m4a",
      "vtt": "voice/otto_success_1.vtt"
    },
    "otto_success_2": {
      "text": "Frames incoming. Stay close.",
      "audio": "voice/otto_success_2.m4a",
      "vtt": "voice/otto_success_2.vtt"
    },
    "otto_success_3": {
      "text": "Wonderful. We roll soon.",
      "audio": "voice/otto_success_3.m4a",
      "vtt": "voice/otto_success_3.vtt"
    },
    "vee_pop_1": {
      "text": "Frames by Thursday. I'm counting.",
      "audio": "voice/vee_pop_1.m4a",
      "vtt": "voice/vee_pop_1.vtt"
    },
    "vee_pop_2": {
      "text": "Deposit starts it. Approval finishes it.",
      "audio": "voice/vee_pop_2.m4a",
      "vtt": "voice/vee_pop_2.vtt"
    },
    "vee_pop_3": {
      "text": "Thirty seconds. Not a frame more.",
      "audio": "voice/vee_pop_3.m4a",
      "vtt": "voice/vee_pop_3.vtt"
    },
    "vee_pop_4": {
      "text": "Seven days. Start to finish.",
      "audio": "voice/vee_pop_4.m4a",
      "vtt": "voice/vee_pop_4.vtt"
    },
    "vee_pop_5": {
      "text": "I keep Otto on schedule.",
      "audio": "voice/vee_pop_5.m4a",
      "vtt": "voice/vee_pop_5.vtt"
    },
    "vee_pop_6": {
      "text": "No crew. No shoot. No excuses.",
      "audio": "voice/vee_pop_6.m4a",
      "vtt": "voice/vee_pop_6.vtt"
    },
    "vee_pop_7": {
      "text": "Your product. Our film. One week.",
      "audio": "voice/vee_pop_7.m4a",
      "vtt": "voice/vee_pop_7.vtt"
    },
    "vee_pop_8": {
      "text": "He wants another take. I said no.",
      "audio": "voice/vee_pop_8.m4a",
      "vtt": "voice/vee_pop_8.vtt"
    },
    "vee_pricing_1": {
      "text": "Pick the size that fits this quarter.",
      "audio": "voice/vee_pricing_1.m4a",
      "vtt": "voice/vee_pricing_1.vtt"
    },
    "vee_pricing_2": {
      "text": "The middle one. Trust me.",
      "audio": "voice/vee_pricing_2.m4a",
      "vtt": "voice/vee_pricing_2.vtt"
    },
    "vee_pricing_3": {
      "text": "Clear prices. No surprises.",
      "audio": "voice/vee_pricing_3.m4a",
      "vtt": "voice/vee_pricing_3.vtt"
    },
    "vee_cta_1": {
      "text": "Send one photo. I'll handle the rest.",
      "audio": "voice/vee_cta_1.m4a",
      "vtt": "voice/vee_cta_1.vtt"
    },
    "vee_cta_2": {
      "text": "Five free frames. Clock starts now.",
      "audio": "voice/vee_cta_2.m4a",
      "vtt": "voice/vee_cta_2.vtt"
    },
    "vee_cta_3": {
      "text": "Tap it. I'm already timing you.",
      "audio": "voice/vee_cta_3.m4a",
      "vtt": "voice/vee_cta_3.vtt"
    }
  },
