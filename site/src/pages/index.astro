---
// The home page has one job: a request for 5 free frames, or a booked film.
// Hero → the problem → how it works → work → pricing → the offer (form) → FAQ → footer.
// Characters appear four times, each in its own reserved slot: Otto (hero), Vee (how it works),
// Otto (pricing), Vee (the offer). Lines and captions: scripts/home/characters.ts.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FilmTile from '../components/FilmTile.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import MiniForm from '../components/MiniForm.astro';
import Presenter from '../components/home/Presenter.astro';
import { media, mediaUrl, filmBySlug } from '../lib/media';
import { site, pricing, money } from '../lib/site';

const demoFilm = filmBySlug('aurum');
// Work: Red Light (the film with a chase, a turn and a product-caused punchline) first, then the films with a turn,
// then the rest (the AURUM demo film already plays in "How it works").
const lead = ['red-light', 'aurum-top-shelf', 'vesper-23', 'tabletop-city'];
const films = [...lead.map((s) => filmBySlug(s)), ...media.films.filter((f) => !lead.includes(f.slug) && f.slug !== demoFilm?.slug)].filter((f) => !!f);
const offers = pricing.tiers.map((t) => ({ '@type': 'Offer', name: t.name, price: t.price, priceCurrency: 'USD' }));
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Service', name: 'AI product films', provider: { '@type': 'Organization', name: site.studio }, offers }];
const steps = [
  { n: '1', title: 'Send one photo.', text: 'Any product shot, any light. Or just the link to your product page.' },
  { n: '2', title: '5 frames in 48 h, free.', text: 'On your product, plus the hook for second one and the punchline in a sentence. No call, no card.' },
  { n: '3', title: 'A test take you approve.', text: `The storyboard, then a 480p test take checked against your frames. The final film: 15–30 s, 9:16 + 4:5, short cuts and stills, with a QC sheet and a list of every AI element. From ${money(pricing.from)}.` },
];
const checks = [
  { k: 'Hook', v: 'Motion or a line in the first frame. No slow reveal.' },
  { k: 'Sound', v: '−14 LUFS, true peak ≤ −1 dBTP, measured on the file you get.' },
  { k: 'Sync', v: 'Every hit on the frame of its action, checked on a frame strip.' },
  { k: 'Claims', v: 'Only your tested numbers on screen. AI never plays the result: your real footage goes in a proof slot.' },
];
---
<Base title={site.studio} description={`15–30 s product ads with a hook in the first second and a punchline your product causes. Made with AI, directed by a person. Start with 5 free frames in 48 hours. From ${money(pricing.from)}.`} home jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={mediaUrl(media.otto.poster)} fetchpriority="high" />
  </Fragment>

  <main id="content" tabindex="-1">
    <Hero />

    <!-- The QC promise: what every film passes before the client sees it (ref 65 P1-1). -->
    <section class="section qc" id="qc" aria-labelledby="qc-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Before you see a film</p>
          <h2 id="qc-h">What every film passes before you see it.</h2>
          <p class="lede">Most AI ads skip these. That's the difference between an AI clip and an ad you can run.</p>
        </div>
        <dl class="qc-grid">
          {checks.map((c) => <div class="qc-item"><dt>{c.k}</dt><dd>{c.v}</dd></div>)}
        </dl>
        <p class="more"><a href="/work/red-light#qc-sheet">See Red Light's QC sheet <span aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <!-- The problem -->
    <section class="section problem" id="problem" aria-labelledby="problem-h">
      <div class="wrap narrow">
        <h2 id="problem-h">Your best ad is getting tired.</h2>
        <p class="lede">The feed stopped noticing it weeks ago. A reshoot means a studio, a crew, three weeks and a bill to match.</p>
        <p class="lede">We make the next one from a single photo.</p>
      </div>
    </section>

    <!-- How it works -->
    <section class="section how" id="how" aria-labelledby="how-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">How it works</p>
          <h2 id="how-h">One photo in. A film out.</h2>
        </div>
        <div class="how-grid">
          <Presenter who="vee" slot="how" lines={['v1']} class="how-vee" />
          <div class="how-demo" data-steps>
            <div class="steps" role="tablist" aria-label="The three steps">
              {steps.map((s, i) => (
                <button type="button" role="tab" class="step" id={`step-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                  <span class="n" aria-hidden="true">{s.n}</span>
                  <span class="txt"><b>{s.title}</b><span>{s.text}</span></span>
                </button>
              ))}
            </div>
            <div class="monitor" data-monitor>
              <figure role="tabpanel" id="panel-0" aria-labelledby="step-0" class="panel">
                <img src={mediaUrl(media.stills['ba_before'])} alt="The plain product photo we start from: a gold can on grey" width="1200" height="1500" loading="lazy" decoding="async" />
                <figcaption class="spec-label">Your photo</figcaption>
              </figure>
              <figure role="tabpanel" id="panel-1" aria-labelledby="step-1" class="panel" hidden>
                <img src={mediaUrl(media.stills['ba_after'])} alt="Frame 3 of 5: the same can on a sunlit terrace with yuzu and ice (AI concept)" width="1200" height="1500" loading="lazy" decoding="async" />
                <figcaption class="spec-label">Frame 3 of 5 · AI concept</figcaption>
              </figure>
              <figure role="tabpanel" id="panel-2" aria-labelledby="step-2" class="panel" hidden>
                {demoFilm && <video muted loop playsinline preload="none" poster={mediaUrl(demoFilm.poster)} data-step-film data-av1={mediaUrl(demoFilm.loop.av1)} data-h264={mediaUrl(demoFilm.loop.h264)} aria-label={`${demoFilm.brand}, ${demoFilm.title}: a few seconds of the finished film`}></video>}
                <figcaption class="spec-label">The film · {demoFilm?.brand} · invented brand · AI</figcaption>
              </figure>
            </div>
          </div>
        </div>
        <div class="cta-block" data-inflow-cta>
          <a class="btn btn-primary" href="#start">Get my 5 free frames <span aria-hidden="true">→</span></a>
          <p class="micro">Free. No call. 48 h.</p>
        </div>
      </div>
    </section>

    <!-- Work -->
    <section class="section work" id="work" aria-labelledby="work-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Work · spec films for invented brands</p>
          <h2 id="work-h">Spec ads for brands we invented. Each one has a turn and a punchline.</h2>
          <p class="lede">We invented these brands so we could show the work without using anyone's product. Your film starts from your real product photo. Tap one to watch it.</p>
        </div>
        <ul class="grid" role="list">
          {films.map((f) => <li><FilmTile film={f} /></li>)}
        </ul>
        <p class="more"><a href="/work">All films and how each was made <span aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section price" id="pricing" aria-labelledby="pricing-h">
      <div class="wrap">
        <div class="price-head">
          <div class="head">
            <p class="eyebrow">Pricing</p>
            <h2 id="pricing-h">Three ways to work with us. Prices on the page.</h2>
            <p class="lede">{pricing.context} <span class="src">Sources: {pricing.contextSources.map((c, i) => <>{i > 0 && ', '}<a href={c.url} rel="noopener" target="_blank">{c.label}</a></>)}.</span></p>
          </div>
          <Presenter who="otto" slot="pricing" lines={['o4']} desk="row" class="price-otto" />
        </div>
        <Pricing compact />
      </div>
    </section>

    <!-- The offer -->
    <section class="section offer" id="start" aria-labelledby="start-h">
      <div class="wrap offer-grid">
        <Presenter who="vee" slot="offer" lines={['v4']} class="offer-vee" />
        <div class="offer-copy">
          <p class="eyebrow">Start here</p>
          <h2 id="start-h">5 free frames.</h2>
          <p class="promise">Your product in 48 hours, plus the hook for second one, the punchline in a sentence and a 60-second walkthrough from the director.</p>
          <ul class="ticks">
            <li>Send one photo, or just your product page.</li>
            <li>Frames marked "AI concept". No call, no card. Yours to keep.</li>
            <li>If you don't love them, you owe nothing and we part friends.</li>
            <li>If you book a film: first take late through our fault? The balance drops 10 %.</li>
          </ul>
        </div>
        <div class="offer-form" data-inflow-cta>
          <MiniForm id="start-form" act="offer" />
          <p class="alt"><a href="/frames">Rather upload a photo and details now? Use the full form</a></p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq-section" id="faq" aria-labelledby="faq-h">
      <div class="wrap narrow">
        <h2 id="faq-h">Straight answers</h2>
        <Faq only={['clients', 'ai-use', 'turnaround', 'revisions', 'ownership', 'need', 'pricing']} openFirst={false} />
      </div>
    </section>
  </main>

  <!-- Phones: one sticky CTA, only when no other CTA or the form is on screen. -->
  <div class="sticky" data-sticky inert>
    <a class="btn btn-primary" href={site.stickyCta.href}>{site.stickyCta.label} <span aria-hidden="true">→</span></a>
  </div>

  <p class="sr-only" data-crew-live aria-live="polite"></p>

  <dialog class="film-dialog" data-film-dialog aria-label="Spec film">
    <div class="fd-inner">
      <form method="dialog" class="fd-close"><button class="fd-x" aria-label="Close film">✕</button></form>
      <div class="fd-frame">
        <video data-fd-video playsinline controls preload="none"></video>
        <span class="spec-label" data-fd-label></span>
      </div>
      <div class="fd-actions btn-row">
        <a class="btn btn-primary" href="#start" data-fd-cta>Get my 5 free frames</a>
        <a class="btn" href="/work" data-fd-more>About this film</a>
      </div>
    </div>
  </dialog>

  <script>
    import '../scripts/home';
  </script>
</Base>

<style>
  main { outline: none; }
  .head { max-width: 760px; margin-bottom: var(--space-head); }
  .narrow > * { max-width: 820px; }
  .cta-block { display: grid; gap: 10px; justify-items: start; margin-top: var(--space-head); }

  /* QC promise */
  .qc { padding-block: calc(var(--space-section) * 0.6); border-top: 1px solid var(--line); }
  .qc-grid { margin: 0; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 700px) { .qc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .qc-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .qc-item { border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; background: var(--ink-2); }
  .qc-item dt { font: 400 1.35rem/1.2 var(--serif); color: var(--brass-hi); margin-bottom: 6px; }
  .qc-item dd { margin: 0; color: var(--text-dim); font-size: 0.93rem; line-height: 1.45; }

  /* The problem */
  .problem { padding-block: calc(var(--space-section) * 0.75); }
  .problem .lede { font-size: var(--fs-lede-lg); max-width: 34ch; color: var(--text-dim); }
  .problem .lede:last-child { color: var(--text); margin-bottom: 0; }
  @media (min-width: 900px) {
    .problem .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 64px; align-items: start; }
    .problem h2 { grid-row: span 2; margin: 0; }
  }

  /* How it works */
  .how-grid { display: grid; gap: 32px; }
  .how-demo { display: grid; gap: 24px; }
  .steps { display: grid; gap: 8px; }
  .step {
    display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; text-align: left; width: 100%;
    padding: 14px 16px; border-radius: 14px; border: 1px solid var(--line); background: transparent; color: var(--text-dim); cursor: pointer;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .step:hover { border-color: var(--line-strong); }
  .step[aria-selected='true'] { border-color: var(--brass); background: rgb(176 141 87 / 0.07); color: var(--text); }
  .n { width: 32px; height: 32px; border-radius: 50%; display: grid; place-content: center; border: 1px solid var(--line-strong); font: 600 0.85rem/1 var(--sans); color: var(--text-dim); }
  .step[aria-selected='true'] .n { background: var(--brass); border-color: var(--brass); color: #1a1510; }
  .txt { display: grid; gap: 2px; font-size: 0.92rem; line-height: 1.45; }
  .txt b { font: 400 1.25rem/1.25 var(--serif); color: var(--text); }
  .monitor { position: relative; width: min(100%, 440px); aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; background: var(--ink-3); border: 1px solid var(--line); justify-self: center; }
  .panel { position: absolute; inset: 0; margin: 0; }
  .panel[hidden] { display: none; }
  .panel img, .panel video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .panel .spec-label { position: absolute; left: 12px; top: 12px; }

  /* Work */
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .more { margin: 28px 0 0; }
  .more a { color: var(--brass-hi); text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }

  /* Pricing */
  .price-head { display: grid; gap: 8px; margin-bottom: var(--space-head); }
  .price-head .head { margin-bottom: 0; }
  .src { color: var(--text-faint); font-size: 0.85em; }

  /* The offer */
  .offer { background: var(--ink-0); }
  .offer-grid { display: grid; gap: 32px; }
  .offer-copy h2 { margin-bottom: 0.25em; }
  .promise { font: 400 var(--fs-lede-lg)/1.35 var(--serif); color: var(--text); max-width: 34ch; }
  .ticks { list-style: none; margin: 24px 0 0; padding: 0; color: var(--text-dim); display: grid; gap: 10px; }
  .ticks li { padding-left: 26px; position: relative; }
  .ticks li::before { content: ''; position: absolute; left: 2px; top: 0.55em; width: 12px; height: 6px; border: solid var(--brass); border-width: 0 0 1.5px 1.5px; rotate: -45deg; }
  .offer-form { background: var(--ink-2); border: 1px solid var(--line); border-radius: 18px; padding: clamp(20px, 4vw, 32px); }
  .alt { margin: 16px 0 0; font-size: 0.85rem; }
  .alt a { color: var(--text-dim); }

  @media (min-width: 900px) {
    .how-grid { grid-template-columns: 210px minmax(0, 1fr); gap: 48px; align-items: start; }
    .how-demo { grid-template-columns: minmax(0, 1fr) minmax(0, 400px); gap: 40px; align-items: center; }
    .price-head { grid-template-columns: minmax(0, 1fr) minmax(0, 440px); align-items: end; gap: 48px; }
    .offer-grid { grid-template-columns: 210px minmax(0, 1fr) minmax(0, 420px); gap: 48px; align-items: start; }
  }
  @media (min-width: 900px) and (max-width: 1099px) {
    .offer-grid { grid-template-columns: 210px minmax(0, 1fr); }
    .offer-form { grid-column: 1 / -1; }
  }

  /* Sticky CTA (phones) */
  .sticky {
    position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: rgb(15 14 13 / 0.9); border-top: 1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    translate: 0 110%; transition: translate 0.3s var(--ease);
  }
  .sticky :global(.btn) { width: 100%; }
  .sticky:global(.on) { translate: 0 0; }
  :global(body.is-home) { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
  @media (min-width: 900px) {
    .sticky { display: none; }
    :global(body.is-home) { padding-bottom: 0; }
  }

  /* Film player */
  .film-dialog { padding: 0; border: 0; background: transparent; max-width: none; max-height: none; width: 100%; height: 100%; color: var(--text); }
  .film-dialog::backdrop { background: rgb(8 7 6 / 0.88); }
  .fd-inner { height: 100%; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; justify-items: center; gap: 12px; padding: 12px var(--gutter) calc(16px + env(safe-area-inset-bottom)); }
  .fd-close { justify-self: end; }
  .fd-x { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: rgb(15 14 13 / 0.7); cursor: pointer; }
  .fd-frame { position: relative; height: 100%; max-height: 760px; aspect-ratio: 9 / 16; max-width: 100%; min-height: 0; }
  .fd-frame video { width: 100%; height: 100%; object-fit: contain; border-radius: 14px; background: #000; }
  .fd-frame .spec-label { position: absolute; left: 10px; top: 10px; right: 10px; width: fit-content; }
  .fd-actions { justify-content: center; }
</style>
