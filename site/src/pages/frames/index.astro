---
import Page from '../../layouts/Page.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../lib/site';
---
<Page title="5 free frames" description="Send one product photo. In 48 hours you get 5 frames of your product, the hook for second one and the punchline in a sentence. Free, no call, no card." eyebrow="Free · no call · no card" heading="See your product in our world before you spend a cent." lede="5 frames of your product, free, in 48 hours. Plus the hook for second one and the punchline in a sentence, and a 60-second walkthrough from the director. Judge us on your product, not on our reel.">
  <div class="wrap frames">
    <div>
      <ul class="ticks">
        <li>5 frames, 1 concept, built around your product</li>
        <li>The hook for second one, and the punchline in one sentence, caused by your product</li>
        <li>A 60-second walkthrough of the frames from the director</li>
        <li>No call needed. No card. Marked "AI concept". Yours to keep.</li>
        <li>If you go ahead, the frames become the storyboard for a 15–30 s film. {site.signature}</li>
      </ul>
      <p class="small dim">Everything we make is AI-made and labelled. <a href="/ai">How we use AI</a>.</p>
    </div>
    <div id="form"><LeadForm id="frames" /></div>
  </div>
</Page>
<style>
  .frames { display: grid; gap: 40px; padding-bottom: 96px; }
  @media (min-width: 960px) { .frames { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; } }
  .ticks { list-style: none; padding: 0; margin: 0 0 20px; }
  .ticks li { padding: 12px 0; border-bottom: 1px solid var(--line); }
</style>
